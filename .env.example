APP_NAME=Podnikatel
APP_URL=http://localhost:8080
APP_KEY=change-this-to-a-long-random-secret
DB_PATH=database/app.sqlite

# AI
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_VISION_MODEL=gpt-5-mini

# Mail (PHP mail fallback; production SMTP can be placed behind your mail relay)
MAIL_FROM=info@example.cz
MAIL_FROM_NAME=Podnikatel

# Stripe SaaS billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# GoPay
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_BASE_URL=https://gw.sandbox.gopay.com/api

# Fio read-only API
FIO_API_TOKEN=

# Salt Edge v6 – multi-bank open banking aggregator
SALTEDGE_APP_ID=
SALTEDGE_SECRET=
SALTEDGE_REDIRECT_URL=${APP_URL}/bank/saltedge/callback

# Production backups (optional remote SCP target, e.g. backup@10.0.0.20)
BACKUP_SCP_TARGET=
BACKUP_REMOTE_DIR=backups
BACKUP_RETENTION_DAYS=30

# AI provider: openai | anthropic
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5

# SaaS super administrators (comma separated email addresses)
SUPER_ADMIN_EMAILS=
